{
  "/inbound/today/arrived": {
    "get": {
      "tags": [
        "Inbound"
      ],
      "summary": "Get Today Arrived Asns",
      "description": "Get all ASNs that arrived today with complete details",
      "operationId": "get_today_arrived_asns_inbound_today_arrived_get",
      "security": [
        {
          "OAuth2PasswordBearer": []
        }
      ],
      "parameters": [
        {
          "name": "warehouse_code",
          "in": "query",
          "required": false,
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Filter by warehouse code",
            "title": "Warehouse Code"
          },
          "description": "Filter by warehouse code"
        }
      ],
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TodayArrivedASNResponse"
                },
                "title": "Response Get Today Arrived Asns Inbound Today Arrived Get"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      }
    }
  },
